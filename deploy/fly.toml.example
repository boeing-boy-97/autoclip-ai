# Example Fly.io blueprint — copy to fly.toml and replace the placeholders.
#
#   cp deploy/fly.toml.example fly.toml
#   fly launch --no-deploy
#   fly volumes create data --size 20 --region bom          # TMP_ROOT + ASR weights
#   fly secrets set SECRET_KEY=... SECRET_ENCRYPTION_KEY=... PASSWORD_PEPPER=... \
#                   DATABASE_URL=... REDIS_URL=... S3_BUCKET=... S3_ACCESS_KEY_ID=... \
#                   S3_SECRET_ACCESS_KEY=... S3_ENDPOINT_URL=... S3_REGION=auto
#   fly deploy
#   fly scale count app=2 worker=1 beat=1
#
# Three processes, one image. `beat` must never be scaled above 1.

app = "autoclip-api"
primary_region = "bom"

[build]
  dockerfile = "backend/Dockerfile"

[deploy]
  release_command = "/app/scripts/release.sh"

[env]
  ENVIRONMENT = "production"
  SESSION_COOKIE_SECURE = "true"
  DOCS_ENABLED = "false"
  STORAGE_BACKEND = "s3"
  S3_FORCE_PATH_STYLE = "false"
  TMP_ROOT = "/data/tmp"
  ASR_MODEL_DIR = "/data/asr-models"
  CELERY_BEAT_SCHEDULE = "/data/celerybeat-schedule"
  MAX_UPLOAD_MB = "512"
  FORWARDED_ALLOW_IPS = "*"
  WEB_CONCURRENCY = "2"
  WORKER_QUEUES = "media,transcribe,analyze"
  WORKER_CONCURRENCY = "1"

[processes]
  app = "/app/scripts/start_api.sh"
  worker = "/app/scripts/start_worker.sh"
  beat = "/app/scripts/start_beat.sh"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "off"      # the API holds sessions; do not cold-start it
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [[http_service.checks]]
    grace_period = "60s"          # torch/opencv/mediapipe imports are slow on first boot
    interval = "15s"
    method = "GET"
    timeout = "5s"
    path = "/api/v1/health/readyz"

[[mounts]]
  source = "data"
  destination = "/data"

# Transcription and rendering are memory-bound: 2 GB is the practical floor for a worker.
[[vm]]
  size = "shared-cpu-2x"
  memory = "2gb"
