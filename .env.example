# =====================================================================================
# AutoClipper AI — environment template
# Copy to `.env` for local development:  cp .env.example .env
#
# Rules enforced by app/core/config.py at boot:
#   * Every variable marked REQUIRED has no silent default — the app fails fast and names it.
#   * Any secret with a placeholder value (e.g. "changeme") is rejected in ENVIRONMENT=production.
#   * Optional integrations (YouTube, paid AI) are reported as NOT CONFIGURED, never faked.
# Nothing in this file is a real credential.
# =====================================================================================

# ----------------------------------------------------------------- app
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console
API_PREFIX=/api/v1
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_VERSION=0.1.0

# ----------------------------------------------------------------- security (REQUIRED)
# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=REPLACE_ME_base64_32_bytes
# Same, but dedicated to OAuth token encryption (AES-256-GCM). Rotatable via key_version.
SECRET_ENCRYPTION_KEY=REPLACE_ME_base64_32_bytes
SESSION_COOKIE_NAME=ac_session
SESSION_TTL_HOURS=168
CSRF_ENABLED=true
PASSWORD_PEPPER=REPLACE_ME_random_string
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_HOUR=30
MAX_UPLOAD_MB=4096

# ----------------------------------------------------------------- database (REQUIRED)
DATABASE_URL=postgresql+psycopg://autoclip:autoclip@localhost:5432/autoclip
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
# Separate role recommended in production (no DDL rights for the app).
DATABASE_URL_MIGRATIONS=postgresql+psycopg://autoclip:autoclip@localhost:5432/autoclip

# ----------------------------------------------------------------- redis / celery (REQUIRED)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false          # true ONLY in tests
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
# A RUNNING job whose heartbeat is older than this is presumed lost and reclaimed by
# `analysis.sweep_stuck`. Keep it comfortably longer than your slowest expected task.
JOB_STUCK_AFTER_SECONDS=900
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Per-queue concurrency. Rendering is memory-hungry: keep low on small hosts.
WORKER_CONCURRENCY_MEDIA=2
WORKER_CONCURRENCY_TRANSCRIBE=1
WORKER_CONCURRENCY_ANALYZE=4
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_QA=2
WORKER_CONCURRENCY_PUBLISH=1
WORKER_CONCURRENCY_ANALYTICS=2
STUCK_JOB_THRESHOLD_SECONDS=7200

# ----------------------------------------------------------------- storage
# Local filesystem is for development only. Production MUST use S3-compatible storage.
STORAGE_BACKEND=local                   # local | s3
LOCAL_STORAGE_ROOT=./storage
# Caption/branding style templates used when rendering a clip. Resolved relative to the repo root,
# so a worker started from any directory still finds them.
TEMPLATE_DIR=config/templates
S3_ENDPOINT_URL=http://localhost:9000    # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=autoclip-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true                # MinIO needs true; R2/S3 usually false
SIGNED_URL_TTL_SECONDS=600
STORAGE_LIFECYCLE_DAYS_DERIVED=30
MIN_FREE_DISK_GB=5

# ----------------------------------------------------------------- FFmpeg / media
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_THREADS=2
TMP_ROOT=/tmp/autoclip
RENDER_TIMEOUT_PER_MINUTE=120           # timeout = clip_duration_min * this (seconds)
RENDER_TARGET_WIDTH=1080
RENDER_TARGET_HEIGHT=1920
RENDER_CRF=20
RENDER_PRESET=veryfast
PREVIEW_HEIGHT=540
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK_DBTP=-1
SCORING_CONFIG_PATH=../config/scoring.yaml   # weights + version stamp for candidate scoring
MAX_SOURCE_DURATION_MINUTES=360

# ----------------------------------------------------------------- transcription
ASR_PROVIDER=local                      # local | openai | deepgram | assemblyai
ASR_MODEL=large-v3                      # faster-whisper model id
ASR_DEVICE=auto                         # auto | cpu | cuda
ASR_COMPUTE_TYPE=auto                   # auto | int8 | float16
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
ASR_MODEL_DIR=./models/asr                # local weight cache; download happens once
# Optional hosted STT (only used when ASR_PROVIDER != local)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Optional diarization (requires accepting model terms on Hugging Face). Absent -> heuristic.
HF_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_ENABLED=false

# ----------------------------------------------------------------- AI reasoning
# The platform runs with NO paid AI configured (deterministic/heuristic fallback) and tells
# you so. Set AI_PROVIDER to enable LLM-driven analysis. Never silently substituted.
AI_PROVIDER=none                        # none | openai | anthropic | google | openai_compatible
AI_MODEL_FAST=gpt-4o-mini               # classification, metadata
AI_MODEL_QUALITY=gpt-4o                 # semantic analysis, moment rationale
AI_MODEL_VISION=gpt-4o-mini             # selected frames only
AI_BASE_URL=                            # for openai_compatible
AI_API_KEY=
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.2
AI_MAX_FRAMES_PER_VIDEO=48
AI_CHUNK_SECONDS=240
AI_CHUNK_OVERLAP_SECONDS=20
AI_CACHE_TTL_SECONDS=604800
AI_RESPONSE_CACHE_ENABLED=true

# ----------------------------------------------------------------- cost control
PROJECT_DEFAULT_BUDGET_USD=5.00
WORKSPACE_MONTHLY_BUDGET_USD=100.00
BUDGET_WARN_THRESHOLD=0.80
BUDGET_HARD_STOP=true
PRICING_CONFIG_PATH=./config/pricing.yaml

# ----------------------------------------------------------------- YouTube (optional integration)
# Leave blank to run the product without publishing. The UI will show the integration as
# NOT CONFIGURED and publishing endpoints return 409 youtube_not_configured.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/yt-analytics.readonly
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
YOUTUBE_WEBHOOK_SECRET=

# ----------------------------------------------------------------- observability
SENTRY_DSN=
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
SLOW_QUERY_MS=500

# ----------------------------------------------------------------- frontend (Next.js)
# Inlined at build time; must be reachable from the browser.
NEXT_PUBLIC_APP_NAME=AutoClipper AI
NEXT_PUBLIC_API_BASE=/api/proxy          # same-origin proxy, avoids CORS entirely
NEXT_PUBLIC_SSE_PATH=/api/proxy/v1
API_INTERNAL_URL=http://localhost:8000   # server-side proxy target
